# aicf-ui 环境配置
#
# 用法：
#   cp .env.example .env   然后填上你的模型端点
#
# 所有项都可以在界面里改（Settings → Provider），这里只列最常用的。
# 查找顺序：环境变量 > .env > 代码默认值。

# ── 主对话后端：openai / lmstudio ──
MAIN_MODEL_TYPE=openai
MAIN_MODEL_NAME=deepseek-chat

# ── OpenAI 兼容端点（DeepSeek / OpenAI / GLM / Kimi / vLLM / OneAPI 都行）──
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-real-key

# ── Web 控制台 ──
DSN_UI_HOST=127.0.0.1
DSN_UI_PORT=8888
# 数据目录（凭据密文 / provider 配置 / 思考链缓存）
# DSN_UI_DATA_DIR=~/.aicf/ui/data
# agent 的默认工作目录
# DSN_UI_WORKSPACE_ROOT=~/projects
# 本地模型 profile 目录
# DSN_UI_MODEL_PROFILES_DIR=~/.aicf/model_profiles

# ── 可选：语音能力（需额外安装 aicf-dsn）──
# AICF_DSN_SKILLS_DIR=
